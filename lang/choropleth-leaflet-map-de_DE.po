msgid "Popup Content"
msgstr "Popup-Inhalt"

#: leafext/choropleth.php:28
msgid "q for quantile, e for equidistant, k for k-means"
msgstr "q für quantile, e für equidistant, k für k-means"

#: leafext/admin-choropleth.php:76
msgid "quantile maps try to arrange groups so they have the same quantity."
msgstr ""
"Bei Quantilkarten wird versucht, die Gruppen so anzuordnen, dass sie die "
"gleiche Menge aufweisen."

#: leafext/choropleth.php:29
msgid "show legend"
msgstr "Legende anzeigen"

#. %s is ashortcode name.
#: leafext/admin-choropleth.php:40
#, php-format
#| msgid ""
#| "Use it like the popup content for Geojsons in Leaflet Map: To add feature "
