msgstr "Beispiel"

#. Author of the plugin
msgid "hupe13"
msgstr "hupe13"

#: leafext/admin-choropleth.php:78
msgid "k-means: each standard deviation becomes a class."
msgstr "k-means: jede Standardabweichung wird zu einer Klasse."

#: leafext/choropleth.php:27
msgid "number of breaks or steps in range"
msgstr "Zahl der Abstände oder Schritte im Bereich"

